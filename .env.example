# Supabase (Project Settings -> API). For local dev, `npx supabase start` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (Google AI Studio) — AI Rig Builder and Spec Comparator.
# Without it the site still works; AI features show a "not enabled" notice.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: override the Gemini model (default: gemini-3.8-flash).
GEMINI_MODEL=
# Optional: Gemini embedding model for product search vectors (default: gemini-embedding-001, 768 dims).
GEMINI_EMBEDDING_MODEL=

# Public site URL used for PayOS return/cancel links (falls back to the request host).
NEXT_PUBLIC_SITE_URL=

# PayOS (my.payos.vn -> Kênh thanh toán). Without these, checkout uses demo payments in development.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Demo payments mark orders paid without money; they are refused in production unless this is "true".
ALLOW_DEMO_PAYMENTS=

# Giao Hàng Nhanh. Without a token, a flat shipping fee is used.
GHN_TOKEN=
GHN_SHOP_ID=
# "production" or "dev" (default dev: dev-online-gateway.ghn.vn)
GHN_ENV=dev
# Pickup address (defaults to the shop's address in GHN)
GHN_FROM_DISTRICT_ID=
GHN_FROM_WARD_CODE=
# Flat fee in VND when GHN is not configured (default 50000)
SHIPPING_FLAT_FEE=
# Max declared value for carrier insurance in VND (default 5000000)
SHIPPING_MAX_INSURANCE_VALUE=

# Admin (/admin). Disabled unless set; at least 12 characters.
ADMIN_PASSWORD=
# Optional separate secret for signing admin sessions (defaults to ADMIN_PASSWORD).
ADMIN_SESSION_SECRET=
